{
  "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "message": { "type": "string" },
      "failed_boards": {
        "type": "array",
        "items": { "type": "string" }
      },
      "id": { "type": "string" },
      "title": { "type": "string" },
      "company": { "type": "string" },
      "location": { "type": "string" },
      "job_type": { "type": "string" },
      "date_posted": { "type": "string" },
      "salary_min": { "type": ["number", "string"] },
      "salary_max": { "type": ["number", "string"] },
      "salary_currency": { "type": "string" },
      "description": { "type": "string" },
      "job_url": { "type": "string" },
      "source": { "type": "string" },
      "is_remote": { "type": "boolean" },
      "ai_score": { "type": ["integer", "null"] },
      "ai_verdict": { "type": ["string", "null"] },
      "ai_missing_skills": {
        "type": ["array", "null"],
        "items": { "type": "string" }
      },
      "keywords": {
        "type": ["array", "null"],
        "items": { "type": "string" }
      },
      "jev_score": { "type": ["number", "null"] },
      "jev_tier": { "type": ["string", "null"] },
      "p_offer": { "type": ["number", "null"] },
      "market_value": { "type": ["number", "null"] },
      "expected_return": { "type": ["number", "null"] }
    }
  },
  "views": {
    "overview": {
      "title": "Jobs",
      "transformation": {
        "fields": [
          "status",
          "message",
          "failed_boards",
          "title",
          "company",
          "location",
          "jev_score",
          "jev_tier",
          "p_offer",
          "expected_return",
          "market_value",
          "ai_score",
          "ai_verdict",
          "source",
          "date_posted",
          "salary_min",
          "salary_max",
          "salary_currency",
          "is_remote",
          "ai_missing_skills",
          "keywords",
          "job_url",
          "description",
          "id"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "title": { "label": "Title", "format": "text" },
          "company": { "label": "Company", "format": "text" },
          "location": { "label": "Location", "format": "text" },
          "jev_score": { "label": "JEV Score", "format": "number" },
          "jev_tier": { "label": "JEV Tier", "format": "text" },
          "p_offer": { "label": "P(Offer)", "format": "number" },
          "expected_return": { "label": "Expected Return ($)", "format": "number" },
          "market_value": { "label": "Market Value ($)", "format": "number" },
          "ai_score": { "label": "AI Score", "format": "number" },
          "ai_verdict": { "label": "AI Verdict", "format": "text" },
          "source": { "label": "Source", "format": "text" },
          "date_posted": { "label": "Date posted", "format": "text" },
          "salary_min": { "label": "Salary min", "format": "text" },
          "salary_max": { "label": "Salary max", "format": "text" },
          "salary_currency": { "label": "Currency", "format": "text" },
          "is_remote": { "label": "Remote", "format": "boolean" },
          "ai_missing_skills": { "label": "Missing skills", "format": "array" },
          "keywords": { "label": "Keywords", "format": "array" },
          "job_url": { "label": "Job URL", "format": "link" },
          "description": { "label": "Description", "format": "text" },
          "status": { "label": "Status", "format": "text" },
          "message": { "label": "Message", "format": "text" },
          "failed_boards": { "label": "Failed boards", "format": "array" },
          "id": { "label": "ID", "format": "text" }
        }
      }
    }
  }
}
